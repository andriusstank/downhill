cabal-version:      3.4
name:               downhill
version:            0.5.0.0
synopsis:           Automatic differentiation
-- description:
homepage:           https://andriusstank.github.io/downhill/
license:            MIT
license-file:       LICENSE
author:             Andrius Stankevičius
maintainer:         floppycat@gmail.com
-- copyright:
category:           Math
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        Downhill.Internal.Graph.OpenGraph
        Downhill.Internal.Graph.OpenMap
        Downhill.Internal.Graph.NodeMap
        Downhill.Internal.Graph.UniGraph
        Downhill.Internal.Graph.Graph
        Downhill.Linear.Builder
        Downhill.Linear.Expr
        Downhill.Linear.Fun
        Downhill.Linear.AD
        Downhill.Tree.At
        Downhill.Tree.Array
        Downhill.Tree.FieldNaming
        Downhill.Tree.Record
        Downhill.Tree.Rec
        Downhill.Tree.HListOf
        Downhill.Tree.RegularRecord
        Downhill.Tree.RTree
        Downhill.Tree.RegularTree
        Downhill.Tree.Representation
        Downhill.Tree.Vector
        Downhill.Tree.PrintRTree
        Downhill.Tree.Tree
        Downhill.Tree.BVar
        Downhill.Opt.GD
        Downhill.VSpace
        Downhill.Manifold
        Downhill.BVar
        Downhill.Orphans
        Downhill.Internal.Test.Ring
        Downhill.Internal.Test.VSpace
        Downhill.Internal.Test.Linear
        Downhill.Algebra
    -- other-modules:
    -- other-extensions:
    build-depends:    base >=4.20 && <4.23,
                      numhask,
                      template-haskell,
                      transformers,
                      unordered-containers,
                      reflection,
                      singletons, singletons-base,
                      constraints,
                      HList,
                      dlist,
                      streams,
                      tasty,
                      hedgehog,
                      tasty-hedgehog,
                      HUnit, hspec, hspec-core, hspec-hedgehog,
                      vector-sized, finite-typelits, text, vinyl, primitive
    hs-source-dirs:   src
    default-language: GHC2024

test-suite downhill-test
    import:           warnings
    default-language: GHC2024
    other-modules:
        DownhillTest.AD
        DownhillTest.Diff
        DownhillTest.MonoLeaf
        DownhillTest.Rec
        DownhillTest.Record
        DownhillTest.RegularRecord
        DownhillTest.RegularRecord.Fixtures
        DownhillTest.RegularRecord.Fields
        DownhillTest.RegularRecord.Structure
        DownhillTest.RegularRecord.BVar
        DownhillTest.RegularRecord.Workflow1
        DownhillTest.RegularRecord.Workflow2
        DownhillTest.Tree
        DownhillTest.Tree.Workflow2
        DownhillTest.GD
        DownhillTest.VSpace.Scalar
        DownhillTest.VSpace.V2
        DownhillTest.VSpace.M2
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        tasty-hedgehog ^>=1.4.0.2,
        base,
        downhill,
        numhask,
        singletons, singletons-base,
        hspec, hspec-core, hspec-expectations, HUnit,
        constraints,
        streams,
        text,
        hedgehog, tasty, tasty-hedgehog,
        reflection, tasty-hunit,
        hspec-hedgehog,
        vinyl,
        vector-sized,
        finite-typelits
