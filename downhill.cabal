cabal-version:      3.4
name:               downhill
version:            0.5.0.0
synopsis:           Automatic differentiation
-- description:
homepage:           https://andriusstank.github.io/downhill/
license:            MIT
license-file:       LICENSE
author:             Andrius Stankevičius
maintainer:         floppycat@gmail.com
-- copyright:
category:           Math
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        Downhill.Internal.Graph.OpenGraph
        Downhill.Internal.Graph.OpenMap
        Downhill.Internal.Graph.NodeMap
        Downhill.Internal.Graph.UniGraph
        Downhill.Internal.Graph.Graph
        Downhill.Linear.Builder
        Downhill.Linear.Expr
        Downhill.Linear.Fun
        Downhill.Linear.AD
        Downhill.Tree.FieldWrapper
        Downhill.Tree.Record
        Downhill.Tree.Tree
        Downhill.Tree.BVar
        Downhill.Opt.GD
        Downhill.VSpace
        Downhill.Manifold
        Downhill.BVar
        Downhill.Orphans
        Downhill.Test
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.20.0.0,
                      numhask,
                      transformers,
                      unordered-containers,
                      reflection,
                      singletons, singletons-base,
                      constraints,
                      dlist,
                      streams,
                      hedgehog
    hs-source-dirs:   src
    default-language: GHC2024

test-suite downhill-test
    import:           warnings
    default-language: GHC2024
    other-modules:
        DownhillTest.AD
        DownhillTest.Diff
        DownhillTest.MonoLeaf
        DownhillTest.Record
        DownhillTest.Tree
        DownhillTest.GD
        DownhillTest.Transpose
        DownhillTest.V2
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base,
        downhill,
        numhask,
        singletons, singletons-base,
        hspec, hspec-expectations, HUnit,
        constraints,
        streams,
        hedgehog
